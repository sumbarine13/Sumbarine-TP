local function makebtn(txt, x, col)
	local btn = Instance.new("TextButton")
	btn.Name = txt.."Button"
	btn.Size = UDim2.new(0, 38, 0, 38)
	btn.Position = UDim2.new(1, x, 0.5, -19)
	btn.Text = txt
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = txt == "−" and 30 or 20
	btn.BackgroundColor3 = col
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.AutoButtonColor = false
	btn.Parent = top
	
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = btn
	
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Thickness = 2
	stroke.Transparency = 0.5
	stroke.Parent = btn
	
	local glow = Instance.new("ImageLabel")
	glow.Name = "Glow"
	glow.Size = UDim2.new(1.6, 0, 1.6, 0)
	glow.Position = UDim2.new(0.5, -30, 0.5, -30)
	glow.BackgroundTransparency = 1
	glow.Image = "rbxasset://textures/ui/GuiImagePlaceholder.png"
	glow.ImageColor3 = col
	glow.ImageTransparency = 0.8
	glow.Parent = btn
	glow.ZIndex = 0
	
	btn.MouseEnter:Connect(function()
		tween:Create(btn, TweenInfo.new(0.25, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {Size = UDim2.new(0, 46, 0, 46), Position = UDim2.new(1, x-4, 0.5, -23), Rotation = 8}):Play()
		tween:Create(stroke, TweenInfo.new(0.2), {Transparency = 0}):Play()
		tween:Create(glow, TweenInfo.new(0.2), {ImageTransparency = 0.4, Size = UDim2.new(2, 0, 2, 0)}):Play()
	end)
	btn.MouseLeave:Connect(function()
		tween:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 38, 0, 38), Position = UDim2.new(1, x, 0.5, -19), Rotation = 0}):Play()
		tween:Create(stroke, TweenInfo.new(0.2), {Transparency = 0.5}):Play()
		tween:Create(glow, TweenInfo.new(0.2), {ImageTransparency = 0.8, Size = UDim2.new(1.6, 0, 1.6, 0)}):Play()
	end)
	
	btn.MouseButton1Down:Connect(function()
		tween:Create(btn, TweenInfo.new(0.1), {Size = UDim2.new(0, 33, 0, 33), Position = UDim2.new(1, x+2.5, 0.5, -16.5)}):Play()
		tween:Create(btn, TweenInfo.new(0.1), {Size = UDim2.new(0, 38, 0, 38), Position = UDim2.new(1, x, 0.5, -19)}):Play()
		local ring = Instance.new("Frame")
		ring.Size = UDim2.new(0, 10, 0, 10)
		ring.Position = UDim2.new(0.5, -5, 0.5, -5)
		ring.BackgroundTransparency = 1
		ring.BorderSizePixel = 0
		ring.Parent = btn
		local rc = Instance.new("UICorner")
		rc.CornerRadius = UDim.new(1, 0)
		rc.Parent = ring
		local rs = Instance.new("UIStroke")
		rs.Color = Color3.new(1, 1, 1)
		rs.Thickness = 2
		rs.Parent = ring
		tween:Create(ring, TweenInfo.new(0.5), {Size = UDim2.new(0, 80, 0, 80), Position = UDim2.new(0.5, -40, 0.5, -40), BackgroundTransparency = 1}):Play()
		tween:Create(rs, TweenInfo.new(0.5), {Transparency = 1}):Play()
		game:GetService("Debris"):AddItem(ring, 0.6)
	end)
	return btn
end

